# Optional remote state. Recommended for team / two-repo workflows so
# state is shared and locked. Copy to backend.tf, fill in a bucket + table
# you own, then run: terraform init -reconfigure
#
# Create these once (bucket + lock table) before init:
#   aws s3 mb s3://YOUR-TFSTATE-BUCKET
#   aws dynamodb create-table --table-name YOUR-TFLOCK-TABLE \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST

terraform {
  backend "s3" {
    bucket         = "YOUR-TFSTATE-BUCKET"
    key            = "scaling-ai-readiness/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "YOUR-TFLOCK-TABLE"
    encrypt        = true
  }
}
