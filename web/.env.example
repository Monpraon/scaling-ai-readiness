# Copy to .env.local and fill in. All values are OPTIONAL.
# Never commit real values — .env* is gitignored.

# Backend API base URL (API Gateway invoke URL or your own domain).
# Leave blank to run fully static: Room results stay on-device and
# "Analyze My Work" is disabled (it needs a backend to reach the model).
VITE_API_BASE=

# Branding — safe to change so you can rehost under your own name.
VITE_BRAND_PRIMARY=Black
VITE_BRAND_ACCENT=Cherry
VITE_CTA_URL=example.com
VITE_EVENT_LABEL=AI for Everyone
