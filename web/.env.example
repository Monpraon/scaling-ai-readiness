# Copy to .env.local and fill in. All values are OPTIONAL.
# Never commit real values — .env* is gitignored.

# Backend API base URL (API Gateway invoke URL or your own domain).
# Leave blank to run fully static — the whole assessment still works;
# only the optional "Explain in plain language" (Bedrock) button is hidden.
VITE_API_BASE=

# Branding — safe to change so you can rehost under your own name.
VITE_BRAND_NAME=Scale My AI
# Optional call-to-action link shown at the end of the report.
VITE_CTA_URL=
